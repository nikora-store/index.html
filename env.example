# ---- Stripe (cards, Apple Pay, Google Pay) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                       # from the webhook endpoint you add in Stripe (see README notes)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...        # served to the page by /api/checkout/config

# ---- PayPal ----
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_ENV=live                                       # "sandbox" while testing (client id/secret must match)

# ---- Firebase (server side) ----
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # whole JSON, or base64 of it
FIREBASE_DB_URL=https://nikora-store-default-rtdb.firebaseio.com

# ---- CJ Dropshipping ----
CJ_API_KEY=...
CJ_LOGISTIC_NAME=...
CJ_FROM_COUNTRY=CN
# CJ_CREATE_ORDER_PATH=/shopping/order/createOrderV2

# ---- Email / site / webhooks ----
SITE_URL=https://nikora-store.vercel.app
EMAIL_ADMIN_SECRET=...                                # same value api/send-email.js expects
FULFILLMENT_WEBHOOK_SECRET=...                        # CJ shipping webhook: ?secret=<this>

# ---- optional ----
GOOGLE_PLACES_API_KEY=                                # browser key restricted to your domain, enables address autocomplete
